  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "description": "Tỷ lệ scrape target Redpanda/RisingWave/observability đang trả metric.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(up{namespace=~\"redpanda|risingwave|observability\"})",
          "legendFormat": "Healthy",
          "range": false,
          "refId": "A",
          "instant": true
        },
        {
          "editorMode": "code",
          "expr": "count(up{namespace=~\"redpanda|risingwave|observability\"})",
          "legendFormat": "Total",
          "range": false,
          "refId": "B",
          "instant": true
        },
        {
          "editorMode": "code",
          "expr": "100 * sum(up{namespace=~\"redpanda|risingwave|observability\"}) / count(up{namespace=~\"redpanda|risingwave|observability\"})",
          "legendFormat": "Health %",
          "range": false,
          "refId": "C",
          "instant": true
        }
      ],
      "title": "Scrape target health",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
