  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "description": "Tỷ lệ scrape target Redpanda/RisingWave/observability đang trả metric.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(up{namespace=~\"redpanda|risingwave|observability\"})",
          "legendFormat": "Healthy",
          "range": false,
          "refId": "A",
          "instant": true
        },
        {
          "editorMode": "code",
          "expr": "count(up{namespace=~\"redpanda|risingwave|observability\"})",
          "legendFormat": "Total",
          "range": false,
          "refId": "B",
          "instant": true
        },
        {
          "editorMode": "code",
          "expr": "100 * sum(up{namespace=~\"redpanda|risingwave|observability\"}) / count(up{namespace=~\"redpanda|risingwave|observability\"})",
          "legendFormat": "Health %",
          "range": false,
          "refId": "C",
          "instant": true
        }
      ],
      "title": "Sức khỏe scrape target",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "description": "Sức khỏe pod trong đường dữ liệu chính.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(kube_pod_status_ready{namespace=~\"pipeline|redpanda|risingwave\",condition=\"true\"})",
          "legendFormat": "Ready",
          "range": false,
          "refId": "A",
          "instant": true
        },
        {
          "editorMode": "code",
          "expr": "count(kube_pod_status_ready{namespace=~\"pipeline|redpanda|risingwave\",condition=\"true\"})",
          "legendFormat": "Total",
          "range": false,
          "refId": "B",
          "instant": true
        },
        {
          "editorMode": "code",
          "expr": "100 * sum(kube_pod_status_ready{namespace=~\"pipeline|redpanda|risingwave\",condition=\"true\"} and on(namespace,pod) (kube_pod_status_phase{namespace=~\"pipeline|redpanda|risingwave\",phase=\"Running\"} == 1)) / count(kube_pod_status_ready{namespace=~\"pipeline|redpanda|risingwave\",condition=\"true\"} and on(namespace,pod) (kube_pod_status_phase{namespace=~\"pipeline|redpanda|risingwave\",phase=\"Running\"} == 1))",
          "legendFormat": "Ready %",
          "range": false,
          "refId": "C",
          "instant": true
        }
      ],
      "title": "Pod pipeline sẵn sàng",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "description": "Lag source Kafka theo catalog RisingWave; 0 nghĩa là consumer đã bắt kịp producer hoặc catalog chưa phản ánh thêm lag.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 1000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(continux_kafka_lag) or vector(0)",
          "legendFormat": "RisingWave proxy",
          "range": false,
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Độ trễ consumer",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "description": "Chỉ dấu đại diện cho luồng Vector ghi vào Redpanda qua mạng container.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "unit": "Bps",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"pipeline\",pod=~\"vector-.*\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "vector transmit",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"redpanda\",pod=~\"redpanda-.*\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "redpanda receive",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Lưu lượng mạng Vector và Redpanda (byte/s)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "description": "Lưu lượng Redpanda từ metric Kafka/RPC/lưu trữ nếu có trong scrape.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
