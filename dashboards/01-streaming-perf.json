        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(redpanda_kafka_request_bytes_total{namespace=\"redpanda\",redpanda_topic=~\"$topic\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Kafka request bytes",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(redpanda_rpc_received_bytes{namespace=\"redpanda\",redpanda_server=\"kafka\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "Kafka RPC received bytes",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Lưu lượng Redpanda (byte/s)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "description": "Offset cuối theo partition; tăng đều khi topic nhận event.",
