        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(kube_pod_status_ready{namespace=~\"pipeline|redpanda|risingwave\",condition=\"true\"})",
          "legendFormat": "Ready",
          "range": false,
          "refId": "A",
          "instant": true
        },
        {
          "editorMode": "code",
          "expr": "count(kube_pod_status_ready{namespace=~\"pipeline|redpanda|risingwave\",condition=\"true\"})",
          "legendFormat": "Total",
          "range": false,
          "refId": "B",
          "instant": true
        },
        {
          "editorMode": "code",
          "expr": "100 * sum(kube_pod_status_ready{namespace=~\"pipeline|redpanda|risingwave\",condition=\"true\"}) / count(kube_pod_status_ready{namespace=~\"pipeline|redpanda|risingwave\",condition=\"true\"})",
          "legendFormat": "Ready %",
          "range": false,
          "refId": "C",
          "instant": true
        }
      ],
      "title": "Pipeline pods ready",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "description": "Lag Kafka theo consumer group nếu Redpanda expose metric này; 0 nghĩa là không lag hoặc chưa có metric.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 1000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(redpanda_kafka_consumer_group_lag{namespace=\"redpanda\",topic=~\"$topic\"}) or vector(0)",
          "legendFormat": "lag",
          "range": false,
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Consumer lag",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "description": "Proxy thực tế cho luồng Vector ghi vào Redpanda qua network container.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "unit": "Bps",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"pipeline\",pod=~\"vector-.*\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "vector transmit",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"redpanda\",pod=~\"redpanda-.*\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "redpanda receive",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Vector and Redpanda network bytes/s",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
