      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Value"
          }
        ]
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "kubelet_volume_stats_available_bytes{namespace=~\"redpanda|risingwave|minio|observability\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
