          "refId": "A",
          "instant": true
        }
      ],
      "title": "Thời gian cutover gần nhất",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "description": "Khoảng thời gian từ lần swap gần nhất; 0 nghĩa là chưa có metric swap.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
